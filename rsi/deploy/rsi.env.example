# Copy this file to rsi/.env and replace every value that applies.
# rsi/.env is excluded from the Docker build context and is git-ignored by rsi/.gitignore.
# Never commit credentials. This file contains no system prompt text.

# Required: absolute host path to the immutable .txt system prompt.
# Use the supplied rsi/system-prompt.txt or an operator-authored file.
# It is bind-mounted read-only at /run/config/system-prompt.txt and must be non-empty.
RSI_SYSTEM_PROMPT_FILE=/absolute/path/to/operator-system-prompt.txt

# Host prerequisites (target acceptance fails closed, it does not skip):
#   Linux kernel with unprivileged user namespaces, Docker seccomp profile support,
#   fs.protected_hardlinks=1, fs.protected_symlinks=1, and a bubblewrap build with
#   --seccomp FD support (the Supervisor generates a nested-userns filter) and
#   `--disable-userns` is deliberately not used because /proc/sys is read-only
#   in unprivileged containers. The image is based on Debian trixie and verifies
#   that feature during docker build; old bookworm packages are not sufficient.
# In an AppArmor host, the container profile must allow the bwrap namespace/mount
# probe. The startup preflight is the authority; there is no unsandboxed fallback.

# Time zone for the Supervisor, logs, sleep deadlines, and Pi.
TZ=UTC
RSI_TIME_ZONE=UTC

# The provided ClinePass model is seeded on a fresh data volume.
RSI_MODEL=cline-pass/deepseek-v4.1-flash
RSI_PROVIDER=cline
RSI_THINKING_LEVEL=high

# The trusted Supervisor runs as root inside the constrained container so it can
# use setpriv to start bwrap under this distinct non-root Worker UID/GID.
RSI_WORKER_UID=10002
RSI_WORKER_GID=10002

# Optional token for the private control sockets. Leave unset to rely on Unix
# socket ownership/permissions.
# RSI_CONTROL_TOKEN=

# Optional deployment knobs.
# RSI_SUPERVISOR_ENTRY=/opt/rsi/src/main.ts
# RSI_HEALTH_MAX_AGE_MS=45000
# RSI_LOG_MAX_BYTES=16777216
# RSI_LOG_KEEP_FILES=4
# RSI_LOG_ROTATE_MS=30000

# Provider credentials are read from the process environment by Pi.
# Uncomment only the providers you actually use; never put real keys in this example.
# CLINE_API_KEY=
# Web search needs a separate supported provider credential; ClinePass alone is insufficient.
# DEEPSEEK_API_KEY=
# OLLAMA_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=

# OAuth/auth.json is not passed through this file. See deploy/compose.auth.yaml.

# Target validation on a real Linux+Docker host (bounded smoke; no real provider):
#   cd .. && node rsi/scripts/linux-smoke.mjs
# Explicit optional soak; default is 24h and is never part of push CI:
#   cd .. && node rsi/scripts/linux-soak.mjs --hours 24 --report /var/tmp/rsi-soak.json
